# Variáveis do serviço (install.sh gera ~/.config/learnharness/learnharness.env
# a partir deste modelo). Edite lá e rode `sudo systemctl restart learnharness`.

# Pasta dos seus dados de estudo — é um clone do repositório privado de backup.
LH_DATA_DIR=@HOME@/learnharness-data
# Chaves de API (fica FORA do backup, permissão 0600).
LH_AUTH_FILE=@HOME@/.config/learnharness/auth.json
# Porta local; o tailscale serve aponta para ela.
PORT=3000
# Chromium para demos e renderizações (o Google Chrome não tem build Linux ARM).
CHROME_PATH=@CHROME_PATH@
# ~/.local/bin é onde o Claude Code fica instalado.
PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin

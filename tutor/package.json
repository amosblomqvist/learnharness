{
  "name": "tutor",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on-top AI code tutor and writer. Pick Claude, Grok, OpenAI or a local model.",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "install-electron",
    "app": "node scripts/package-mac.mjs",
    "check:study": "node scripts/check-study.mjs",
    "dist": "node scripts/package-mac.mjs --dist",
    "build:quest": "python3 scripts/quest/build.py src/study/content/quest.md",
    "build:workshop": "python3 scripts/workshop/build.py src/study/content/workshop.md",
    "build:tsquest": "python3 scripts/tsquest/build.py src/study/content/tsquest.md"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.1",
    "@ai-sdk/anthropic": "^4.0.68",
    "@ai-sdk/mcp": "^2.0.62",
    "@ai-sdk/openai": "^4.0.81",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@ai-sdk/xai": "^5.0.12",
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.122",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "mermaid": "^12.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

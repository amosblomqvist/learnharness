# Optional override for the shared Labs thread sync deployment. Copy your public
# deployment URL into .env.local or pass it in the packaged launcher's environment.
LH_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud

# Optional packaged desktop OAuth return port (default 3211).
# Add its exact http://127.0.0.1:PORT origin to AUTH_REDIRECT_ORIGINS on Convex.
# LH_CLOUD_CALLBACK_PORT=3211

# Set these ONLY on the Convex deployment, using its dashboard:
# AUTH_GOOGLE_CLIENT_ID
# AUTH_GOOGLE_CLIENT_SECRET
# AUTH_REDIRECT_ORIGINS=http://localhost:3000,http://127.0.0.1:3211

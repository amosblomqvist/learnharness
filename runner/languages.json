        "runSec": 8
      }
    },
    "swift": {
      "label": "Swift",
      "file": "main.swift",
      "compile": "/opt/codetools/swift-6.0.3-RELEASE-ubuntu24.04/usr/bin/swiftc main.swift -o prog",
      "run": "LD_LIBRARY_PATH=/opt/codetools/swift-6.0.3-RELEASE-ubuntu24.04/usr/lib/swift/linux ./prog",
      "version": "/opt/codetools/swift-6.0.3-RELEASE-ubuntu24.04/usr/bin/swift --version",

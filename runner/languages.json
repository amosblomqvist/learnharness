{
  "_comment": "Language manifest for the LearnHarness sandbox runner. `file` is the source filename written into the run's tmpfs. `compile` is optional (interpreted languages). `run` always executes the program. `limits.compileSec`/`runSec` are enforced by `timeout(1)` INSIDE the sandbox, and the whole unit is additionally capped by RuntimeMaxSec.",
  "languages": {
    "c": {
      "label": "C",
      "file": "main.c",
      "compile": "gcc -O1 -std=c11 -Wall -o prog main.c",
      "run": "./prog",
      "version": "gcc -dumpversion",
      "limits": {
        "compileSec": 15,
        "runSec": 5
      }
    },
    "cpp": {
      "label": "C++",
      "file": "main.cpp",
      "compile": "g++ -O1 -std=c++17 -Wall -o prog main.cpp",
      "run": "./prog",
      "version": "g++ -dumpversion",
      "limits": {
        "compileSec": 20,
        "runSec": 5
      }
    },
    "rust": {
      "label": "Rust",
      "file": "main.rs",
      "compile": "rustc -O -o prog main.rs",
      "run": "./prog",
      "version": "rustc --version",
      "limits": {
        "compileSec": 25,
        "runSec": 5
      }
    },
    "go": {
      "label": "Go",
      "file": "main.go",
      "compile": "go build -o prog main.go",
      "run": "./prog",
      "version": "go version",
      "limits": {
        "compileSec": 25,
        "runSec": 5
      },
      "env": {
        "GOFLAGS": "-mod=mod",
        "GOPATH": "$PWD/.gopath",
        "GOCACHE": "$PWD/.gocache"
      }
    },
    "java": {
      "label": "Java",
      "file": "Main.java",
      "compile": "javac -d . Main.java",
      "run": "java Main",
      "version": "javac -version",
      "limits": {
        "compileSec": 25,
        "runSec": 5
      },
      "classFromCode": true
    },
    "kotlin": {
      "label": "Kotlin",
      "file": "Main.kt",
      "compile": "kotlinc Main.kt -include-runtime -d prog.jar",
      "run": "java -jar prog.jar",
      "version": "kotlinc -version",
      "limits": {
        "compileSec": 45,
        "runSec": 8
      }
    },
    "csharp": {
      "label": "C#",
      "file": "Main.cs",
      "compile": "mcs -out:prog.exe Main.cs",
      "run": "mono prog.exe",
      "version": "mcs --version",
      "limits": {
        "compileSec": 20,
        "runSec": 5
      }
    },
    "python": {
      "label": "Python",
      "file": "main.py",
      "run": "python3 main.py",
      "version": "python3 --version",
      "limits": {
        "runSec": 5
      },
      "checkAppend": "\nimport json as _lh_json\n_lh_checks = _lh_json.loads(r\"\"\"__LH_CHECKS__\"\"\")\nfor _lh_c in _lh_checks:\n    try:\n        _lh_v = eval(_lh_c[\"expr\"])\n        _lh_ok = _lh_c[\"expect\"] in (str(_lh_v), repr(_lh_v))\n    except Exception:\n        _lh_ok = False\n    print(\"@@LH_CHECK\", \"PASS\" if _lh_ok else \"FAIL\", _lh_c[\"label\"])\n"
    },
    "ruby": {
      "label": "Ruby",
      "file": "main.rb",
      "run": "ruby main.rb",
      "version": "ruby --version",
      "limits": {
        "runSec": 5
      },
      "checkAppend": "\nrequire \"json\"\nchecks = JSON.parse(%q{__LH_CHECKS__})\nchecks.each do |c|\n  ok = begin\n    v = eval(c[\"expr\"])\n    c[\"expect\"] == v.to_s\n  rescue StandardError\n    false\n  end\n  puts(\"@@LH_CHECK #{ok ? \"PASS\" : \"FAIL\"} #{c[\"label\"]}\")\nend\n"
    },
    "php": {
      "label": "PHP",
      "file": "main.php",
      "run": "php main.php",
      "version": "php --version",
      "limits": {
        "runSec": 5
      }
    },
    "lua": {
      "label": "Lua",
      "file": "main.lua",
      "run": "lua5.4 main.lua",
      "version": "lua5.4 -v",
      "limits": {
        "runSec": 5
      }
    },
    "perl": {
      "label": "Perl",
      "file": "main.pl",
      "run": "perl main.pl",
      "version": "perl -v",
      "limits": {
        "runSec": 5
      }
    },
    "bash": {
      "label": "Bash",
      "file": "main.sh",
      "run": "bash main.sh",
      "version": "bash --version",
      "limits": {
        "runSec": 5
      }
    },
    "r": {
      "label": "R",
      "file": "main.R",
      "run": "Rscript main.R",

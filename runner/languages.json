      }
    },
    "erlang": {
      "label": "Erlang",
      "file": "main.escript",
      "run": "escript main.escript",
      "version": "erl -noshell -eval 'io:format(\"OTP ~s~n\",[erlang:system_info(otp_release)]),halt().'",
      "limits": {
        "runSec": 10
      },
      "prepend": "#!/usr/bin/env escript"
    },
    "elixir": {
      "label": "Elixir",
      "file": "main.exs",
      "run": "elixir main.exs",
      "version": "elixir --version",
      "limits": {
        "runSec": 12
      },
      "env": {
        "HOME": "$PWD"
      }
    },
    "clojure": {
      "label": "Clojure",
      "file": "main.clj",
